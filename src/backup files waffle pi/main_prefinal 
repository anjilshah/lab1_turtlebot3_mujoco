# ============================================================
# UPDATE INFORMATION
# ============================================================

def update_information():

    # --------------------------------------------------------
    # Position
    # --------------------------------------------------------

    position = data.xpos[
        base_id
    ].copy()


    # --------------------------------------------------------
    # BODY -> WORLD ROTATION
    # --------------------------------------------------------

    R_WB = data.xmat[
        base_id
    ].reshape(
        3,
        3
    ).copy()


    # --------------------------------------------------------
    # YAW
    # --------------------------------------------------------

    yaw = np.arctan2(
        R_WB[1, 0],
        R_WB[0, 0]
    )


    yaw_deg = np.degrees(
        yaw
    )


    # --------------------------------------------------------
    # INFORMATION
    # --------------------------------------------------------

    text = ""


    text += (
        "==========================================================\n"
    )

    text += (
        "              TURTLEBOT3 WAFFLE PI\n"
    )

    text += (
        "==========================================================\n\n"
    )


    # --------------------------------------------------------
    # CONTROLS
    # --------------------------------------------------------

    text += "CONTROLS\n"

    text += (
        "----------------------------------------------------------\n"
    )

    text += "UP       = Forward\n"

    text += "DOWN     = Backward\n"

    text += "LEFT     = Rotate Left\n"

    text += "RIGHT    = Rotate Right\n"

    text += "SPACE    = Stop\n"

    text += "ESC      = Exit\n\n"


    # --------------------------------------------------------
    # CURRENT POSITION
    # --------------------------------------------------------

    text += "CURRENT ROBOT POSITION\n"

    text += (
        "----------------------------------------------------------\n"
    )

    text += (
        f"X = {position[0]: .8f} m\n"
    )

    text += (
        f"Y = {position[1]: .8f} m\n"
    )

    text += (
        f"Z = {position[2]: .8f} m\n"
    )

    text += (
        f"Yaw = {yaw_deg: .8f} degrees\n\n"
    )


    # --------------------------------------------------------
    # ROTATION MATRIX
    # --------------------------------------------------------

    text += (
        "BODY FRAME WITH RESPECT TO GROUND/WORLD\n"
    )

    text += (
        "----------------------------------------------------------\n"
    )

    text += (
        "R_WB = Body axes expressed in World coordinates\n\n"
    )


    text += (
        f"[ {R_WB[0,0]: .10f}   "
        f"{R_WB[0,1]: .10f}   "
        f"{R_WB[0,2]: .10f} ]\n"
    )


    text += (
        f"[ {R_WB[1,0]: .10f}   "
        f"{R_WB[1,1]: .10f}   "
        f"{R_WB[1,2]: .10f} ]\n"
    )


    text += (
        f"[ {R_WB[2,0]: .10f}   "
        f"{R_WB[2,1]: .10f}   "
        f"{R_WB[2,2]: .10f} ]\n\n"
    )


    # --------------------------------------------------------
    # INTERPRETATION
    # --------------------------------------------------------

    text += "MATRIX INTERPRETATION\n"

    text += (
        "----------------------------------------------------------\n"
    )

    text += (
        "Column 1 = Body X / Forward in World coordinates\n"
    )

    text += (
        "Column 2 = Body Y / Left in World coordinates\n"
    )

    text += (
        "Column 3 = Body Z / Up in World coordinates\n\n"
    )


    # --------------------------------------------------------
    # FRAMES
    # --------------------------------------------------------

    text += "REFERENCE FRAMES\n"

    text += (
        "----------------------------------------------------------\n"
    )

    text += "WORLD X = RED\n"

    text += "WORLD Y = GREEN\n"

    text += "WORLD Z = BLUE\n\n"

    text += "BODY X = RED = FORWARD\n"

    text += "BODY Y = GREEN = LEFT\n"

    text += "BODY Z = BLUE = UP\n\n"


    # --------------------------------------------------------
    # MODEL JOINTS
    # --------------------------------------------------------

    text += "BASE JOINTS\n"

    text += (
        "----------------------------------------------------------\n"
    )

    text += "base_x   = X position\n"

    text += "base_y   = Y position\n"

    text += "base_yaw = yaw rotation\n"

    text += "Z        = fixed at 0.11 m\n\n"


    # --------------------------------------------------------
    # CAMERA
    # --------------------------------------------------------

    text += "CAMERA\n"

    text += (
        "----------------------------------------------------------\n"
    )

    text += (
        f"Follow Robot = {FOLLOW_ROBOT}\n"
    )

    text += (
        f"Distance     = {CAMERA_DISTANCE:.3f} m\n"
    )

    text += (
        f"Azimuth      = {CAMERA_AZIMUTH:.2f} degrees\n"
    )

    text += (
        f"Elevation    = {CAMERA_ELEVATION:.2f} degrees\n\n"
    )


    # --------------------------------------------------------
    # SIMULATION
    # --------------------------------------------------------

    text += (
        f"SIMULATION TIME = {data.time:.4f} s\n"
    )


    # --------------------------------------------------------
    # UPDATE
    # --------------------------------------------------------

    info_text.delete(
        "1.0",
        tk.END
    )


    info_text.insert(
        tk.END,
        text
    )


